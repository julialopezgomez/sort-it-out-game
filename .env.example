# Copy this file to `.env` and fill in the values from your own free Supabase project.
# Never commit the real `.env` file. Never put the Supabase *service role* key here:
# everything in this file is compiled into the public JavaScript bundle.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The "anon" / "publishable" public API key. This one is meant to be public;
# the database protects itself with revoked table grants and SECURITY DEFINER RPCs.
VITE_SUPABASE_ANON_KEY=

# Optional. Base path used by Vite when building for GitHub Pages.
# Project site  -> /REPOSITORY-NAME/
# Custom domain -> /
VITE_BASE_PATH=/

# Optional. Shown on the "service unavailable" screen so the owner can find the
# dashboard quickly. Example: https://supabase.com/dashboard/project/abcdefghijklmnop
VITE_SUPABASE_DASHBOARD_URL=
